# AI generation ----------------------------------------------------------------
#
# The model never gets tools: it returns files as JSON, the CLI writes them to
# a staging folder and checks them statically (nothing generated is executed),
# and the user reviews the result before it reaches the applets folder.

AI_TIMEOUT = 300
AI_REPAIRS = 2
MAX_FILES = 20
MAX_FILE_BYTES = 100_000
PROVIDERS = ("claude", "codex")

# The running model CLI, so Ctrl-C and timeouts can stop its process group.
CHILD = None

AI_GUIDE = """You write applets: tiny desktop apps for a Quickshell (Wayland) desktop.
The full format specification follows, then example applets.

<spec>
{spec}
</spec>

<examples>
{examples}
</examples>

Rules:
- Prefer a script applet (bash or python3 standard library) printing JSON.
  Use QML only for visuals a list cannot show (custom bar items, graphics).
- Scripts may use common tools: bash, python3, curl, jq, coreutils, git,
  notify-send. Use `curl --max-time 10` for network requests. Never ask for or
  embed secrets or API keys; prefer services that need none.
- Store state in $APPLET_DATA, settings in [config].
- QML: `import qs.Applets`, root declares `required property var applet`, use
  AppletTheme colors and AppletText/AppletButton/AppletField. Quickshell
  modules (Quickshell, Quickshell.Io, Quickshell.Services.Mpris, ...) are available.
- Keep it small and readable, with brief comments where intent is unclear.
- Interface text is English.

Answer with ONLY one JSON object, no markdown, no explanation:
{{"summary": "one sentence describing what you built or changed",
  "files": {{"relative/path": "complete file contents", ...}},
  "delete": ["relative/path", ...]}}
Paths are relative to the applet folder itself, such as "applet.toml" and
"main.sh". Never prefix them with the applet's name.
"""


def find_cli(provider):
    """Path of the claude/codex CLI, also checking ~/.local/bin, or None."""
    local = Path.home() / ".local/bin" / provider
    if shutil.which(provider):
        return shutil.which(provider)
    if local.is_file() and os.access(local, os.X_OK):
        return str(local)
    return None


def pick_provider(choice):
    if choice:
        if not find_cli(choice):
            die(f"{choice} CLI not found; install it and sign in first")
        return choice
    for provider in PROVIDERS:
        if find_cli(provider):
            return provider
    die("neither the claude nor the codex CLI is installed")


def configured_model(provider):
    """The model (and Codex reasoning effort) set in the CLI's own config.

    Only these values are read; everything else in the config stays ignored.
    Returns (None, None) when nothing is set or the file cannot be read.
    """
    try:
        if provider == "codex":
            home = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")
            config = tomllib.loads((home / "config.toml").read_text())
            profile = config.get("profiles", {}).get(config.get("profile", ""), {})
            model = profile.get("model", config.get("model"))
            effort = profile.get("model_reasoning_effort", config.get("model_reasoning_effort"))
        else:
            home = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
            model, effort = json.loads((home / "settings.json").read_text()).get("model"), None
    except (OSError, ValueError, AttributeError):
        return None, None

    def text(value):
        return value if isinstance(value, str) and value else None

    return text(model), text(effort)


def resolve_ai(args):
    """Provider, model and effort for a generation run, with where the model came from.

    Precedence: --model, then QSA_CLAUDE_MODEL / QSA_CODEX_MODEL, then the
    model in the CLI's own config, then the CLI's default.
    """
    provider = pick_provider(args.provider)
    model, effort = configured_model(provider)
    source = "from your CLI config" if model else "CLI default"
    variable = f"QSA_{provider.upper()}_MODEL"
    if args.model:
        model, source = args.model, "from --model"
    elif os.environ.get(variable):
        model, source = os.environ[variable], f"from {variable}"
    return {"provider": provider, "model": model, "effort": effort, "source": source}


def describe_ai(ai):
    name = ai["provider"].capitalize()
    return f"{name} ({ai['model']}, {ai['source']})" if ai["model"] else f"{name} ({ai['source']} model)"


def stop_child():
    if CHILD and CHILD.poll() is None:
        try:
            os.killpg(CHILD.pid, signal.SIGTERM)
            CHILD.wait(timeout=3)
        except ProcessLookupError:
            pass
        except subprocess.TimeoutExpired:
            os.killpg(CHILD.pid, signal.SIGKILL)


def run_provider(command, stdin, cwd):
    global CHILD
    CHILD = subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                             stderr=subprocess.PIPE, text=True, cwd=cwd, start_new_session=True)
    try:
        output, errors = CHILD.communicate(stdin, timeout=AI_TIMEOUT)
        return CHILD.returncode, output, errors
    except subprocess.TimeoutExpired:
        die(f"the model did not answer within {AI_TIMEOUT // 60} minutes")
    finally:
        stop_child()
        CHILD = None


def ask_model(ai, prompt):
    """Send one prompt with every tool disabled; return the final text.

    Both CLIs run in an empty temporary folder without user configuration,
    MCP servers or session history, and use the CLI's existing login. Only the
    model and effort from resolve_ai() are passed on.
    """
    executable = find_cli(ai["provider"])
    with tempfile.TemporaryDirectory(prefix="applet-ai-") as workspace:
        if ai["provider"] == "codex":
            answer = Path(workspace) / "answer.txt"
            command = [
                executable, "exec", "--ignore-user-config", "--ephemeral",
                "--skip-git-repo-check", "--sandbox", "read-only", "--color", "never",
                "--disable", "shell_tool", "--disable", "unified_exec", "--disable", "hooks",
                "--disable", "shell_snapshot", "--output-last-message", str(answer),
            ]
            if ai["model"]:
                command += ["-m", ai["model"]]
            if ai["effort"]:
                command += ["-c", f"model_reasoning_effort={json.dumps(ai['effort'])}"]
            command.append("-")
            code, _, errors = run_provider(command, prompt, workspace)
            if code or not answer.is_file():
                detail = errors.strip()[-500:]
                die("Codex failed; check your CLI login and account access" + (f"\n{detail}" if detail else ""))
            return answer.read_text(encoding="utf-8")

        command = [
            executable, "--print", "--output-format", "json", "--tools", "",
            "--strict-mcp-config", "--mcp-config", '{"mcpServers":{}}',
            "--setting-sources", "", "--no-session-persistence", "--disable-slash-commands",
            "--permission-mode", "dontAsk",
        ] + (["--model", ai["model"]] if ai["model"] else [])
        code, output, errors = run_provider(command, prompt, workspace)
        try:
            result = json.loads(output)
        except json.JSONDecodeError:
            result = {}
        if code or result.get("is_error") or "result" not in result:
            detail = result.get("result") or errors.strip()[-500:]
            die("Claude failed; check your CLI login and account access" + (f"\n{detail}" if detail else ""))
        return result["result"]


def parse_answer(text):
    """Validate the model's JSON answer; return (files, delete, summary).

    Paths must be relative, without `..` or hidden parts, so writes stay
    inside the staging folder.
    """
    text = text.strip()
    fenced = re.match(r"^```(?:json)?\s*(.*?)\s*```$", text, re.S)
    if fenced:
        text = fenced.group(1)
    try:
        answer = json.loads(text)
    except json.JSONDecodeError:
        start, end = text.find("{"), text.rfind("}")
        if start < 0 or end < start:
            raise ValueError("the answer was not JSON")
        answer = json.loads(text[start:end + 1])
    if not isinstance(answer, dict):
        raise ValueError("the answer must be a JSON object")
    files = answer.get("files")
    delete = answer.get("delete", [])
    if not isinstance(files, dict) or not all(isinstance(v, str) for v in files.values()):
        raise ValueError("'files' must map paths to file contents")
    if not isinstance(delete, list) or not all(isinstance(p, str) for p in delete):
        raise ValueError("'delete' must be a list of paths")
    if len(files) > MAX_FILES:
        raise ValueError(f"at most {MAX_FILES} files")
    for path in [*files, *delete]:
        parts = Path(path).parts
        if not parts or Path(path).is_absolute() or ".." in parts or any(p.startswith(".") for p in parts):
            raise ValueError(f"unsafe path: {path!r}")
    for path, content in files.items():
        if len(content.encode()) > MAX_FILE_BYTES:
            raise ValueError(f"{path} is too large")
    return files, delete, str(answer.get("summary", "")).strip()


def strip_folder(files, delete, name):
    """Drop a `<name>/` prefix the model put on every path despite the rules."""
    prefix = f"{name}/"
    paths = [*files, *delete]
    if not paths or not all(path.startswith(prefix) for path in paths):
        return files, delete
    return ({path[len(prefix):]: content for path, content in files.items()},
            [path[len(prefix):] for path in delete])


def text_files(folder, limit=MAX_FILE_BYTES):
    """Readable text files of an applet, relative path -> content."""
    found = {}
    for path in sorted(folder.rglob("*")):
        rel = path.relative_to(folder)
        if path.is_symlink() or not path.is_file() or any(p.startswith(".") or p == "__pycache__" for p in rel.parts):
            continue
        try:
            content = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        if limit is None or len(content) <= limit:
            found[str(rel)] = content
    return found


def reject_symlinks(folder):
    """Reject links before an applet is read, edited or installed."""
    if folder.is_symlink():
        raise ValueError(f"symlinks are not supported: {folder.name}")
    for root, dirs, files in os.walk(folder, followlinks=False):
        for name in dirs + files:
            path = Path(root) / name
            if path.is_symlink():
                raise ValueError(f"symlinks are not supported: {path.relative_to(folder)}")


def staging_path(folder, path):
    """Validate generated paths again at the write boundary, without following links."""
    parts = Path(path).parts
    if not parts or Path(path).is_absolute() or any(p == ".." or p.startswith(".") for p in parts):
        raise ValueError(f"unsafe path: {path!r}")
    target = folder
    if folder.is_symlink():
        raise ValueError("the staging folder must not be a symlink")
    for part in parts:
        target = target / part
        if target.is_symlink():
            raise ValueError(f"unsafe symlink path: {path!r}")
    if folder.resolve() not in target.resolve().parents:
        raise ValueError(f"path escapes staging: {path!r}")
    return target


def apply_files(folder, files, delete):
    # Validate the entire batch before applying any of it.
    targets = {path: staging_path(folder, path) for path in [*files, *delete]}
    for path in delete:
        target = targets[path]
        if target.is_file():
            target.unlink()
    for path, content in files.items():
        target = targets[path]
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(content, encoding="utf-8")
        if content.startswith("#!"):
            target.chmod(0o755)


def replace_applet(staging, target):
    """Prepare a complete replacement on the same filesystem, with rollback."""
    reject_symlinks(staging)
    tmp = Path(tempfile.mkdtemp(prefix=f".{target.name}.swap-", dir=target.parent))
    prepared, old = tmp / "new", tmp / "old"
    try:
        shutil.copytree(staging, prepared)
        try:
            target.rename(old)
            prepared.rename(target)
        except BaseException:
            if old.exists():
                old.rename(target)
            raise
        shutil.rmtree(old)
    finally:
        # If rollback itself fails, retain the original for manual recovery.
        if not old.exists():
            shutil.rmtree(tmp)


def qml_linter():
    """Prefer Qt 6; a Qt 5 linter cannot validate our Qt 6 QML syntax."""
    for candidate in ("/usr/lib/qt6/bin/qmllint", shutil.which("qmllint6"), shutil.which("qmllint")):
        if not candidate or not os.access(candidate, os.X_OK):
            continue
        version = subprocess.run([candidate, "--version"], capture_output=True, text=True)
        if re.search(r"\b6\.\d", version.stdout + version.stderr):
            return candidate
    return None


def static_problems(folder, name, checks=None):
    """Problems found in a staged applet without running any of its code."""
    problems = []
    applet, error = load(folder)
    if error and error.startswith("missing"):
        return [f"{error}: it must be at the top of the applet folder (paths are relative to it)"]
    if error:
        return [f"applet.toml: {error}"]
    if applet["name"] != name:
        problems.append(f"applet.toml: name must be {name!r}")
    if checks is not None:
        checks.append("manifest and entry permissions")
    qml_files = []
    qml_roots = {applet["entry"], applet["barEntry"]}
    for rel, content in text_files(folder, limit=None).items():
        shebang = content.split("\n", 1)[0] if content.startswith("#!") else ""
        if rel.endswith(".py") or "python" in shebang:
            try:
                compile(content, rel, "exec")  # parses only; nothing runs
                if checks is not None:
                    checks.append(f"{rel}: Python syntax")
            except SyntaxError as error:
                problems.append(f"{rel}:{error.lineno}: {error.msg}")
        elif rel.endswith(".sh") or re.search(r"\b(ba)?sh\b", shebang):
            # Syntax checking must not source a caller's shell startup file.
            env = {key: value for key, value in os.environ.items() if key not in ("BASH_ENV", "ENV")}
            checked = subprocess.run(["bash", "--noprofile", "--norc", "-n", str(folder / rel)],
                                     env=env, capture_output=True, text=True)
            if checked.returncode:
                problems.append(checked.stderr.strip().replace(str(folder) + "/", ""))
            elif checks is not None:
                checks.append(f"{rel}: shell syntax")
        elif rel.endswith(".qml"):
            qml_files.append(folder / rel)
            if str((folder / rel).resolve()) in qml_roots and not re.search(r"\brequired\s+property\s+var\s+applet\b", content):
                problems.append(f"{rel}: the root item must declare `required property var applet`")
            if re.search(r"^import\s+Applets\b", content, re.M):
                problems.append(f"{rel}: import the module as `import qs.Applets`")
    if qml_files:
        linter = qml_linter()
        if linter:
            with tempfile.TemporaryDirectory(prefix="applet-lint-") as tmp:
                module = Path(tmp) / "qs" / "Applets"
                module.parent.mkdir()
                module.symlink_to(RUNTIME / "Applets", target_is_directory=True)
                checked = subprocess.run([linter, "--ignore-settings", "-I", tmp,
                                          "--import", "error", "--unresolved-type", "error",
                                          *map(str, qml_files)], capture_output=True, text=True)
            if checked.returncode:
                problems.append("QML lint: " + (checked.stdout + checked.stderr).strip().replace(str(folder) + "/", ""))
            elif checks is not None:
                checks.append("QML syntax, imports and types (Qt 6 qmllint)")
        elif checks is not None:
            checks.append("QML root declarations; full QML lint skipped (Qt 6 qmllint unavailable)")
    return problems


def publish_applet(staging, target):
    """Atomically publish a directory without replacing a concurrent install.

    Quickshell targets Linux; renameat2(RENAME_NOREPLACE) closes the race that
    exists between checking a destination and an ordinary rename.
    """
    rename = getattr(ctypes.CDLL(None, use_errno=True), "renameat2", None)
    if rename is None:
        raise OSError("atomic installation requires Linux renameat2 support")
    rename.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
    rename.restype = ctypes.c_int
    if rename(-100, os.fsencode(staging), -100, os.fsencode(target), 1) != 0:
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error), str(target))


def guide():
    """The fixed part of every prompt: rules, SPEC.md and example applets."""
    spec = (REPO / "SPEC.md").read_text(encoding="utf-8")
    parts = []
    for name in ("tz", "dice", "media"):
        for rel, content in text_files(REPO / "examples" / name).items():
            parts.append(f'<file applet="{name}" path="{rel}">\n{content}</file>')
    return AI_GUIDE.format(spec=spec, examples="\n".join(parts))


def render_files(files):
    return "\n".join(f'<file path="{rel}">\n{content}</file>' for rel, content in files.items())


def generate(ai, prompt, staging, name):
    """Ask, apply and statically check, sending problems back for repair."""
    summary = ""
    for attempt in range(AI_REPAIRS + 1):
        status = f"Asking {describe_ai(ai)}…" if attempt == 0 else f"Fixing problems (round {attempt})…"
        print(status, file=sys.stderr)
        text = ask_model(ai, prompt)
        try:
            files, delete, summary = parse_answer(text)
            files, delete = strip_folder(files, delete, name)
            apply_files(staging, files, delete)
        except (ValueError, json.JSONDecodeError) as error:
            problems = [f"invalid answer: {error}"]
        else:
            problems = static_problems(staging, name)
        if not problems:
            return summary
        prompt = (f"{guide()}\nYour previous answer had these problems:\n"
                  + "\n".join(f"- {p}" for p in problems)
                  + f"\n\nCurrent files of applet {name!r}:\n{render_files(text_files(staging))}\n\n"
                  "Return the corrected files in the same JSON format.")
    die("the model could not produce a valid applet:\n" + "\n".join(f"  {p}" for p in problems))


def show_files(staging):
    for rel, content in text_files(staging).items():
        print(f"\n── {rel} " + "─" * max(0, 60 - len(rel)))
        print(content.rstrip())
    print()


def show_diff(before, staging):
    """Print a unified diff against `before`; return whether anything changed."""
    after = text_files(staging)
    changed = False
    for rel in sorted(set(before) | set(after)):
        old, new = before.get(rel, ""), after.get(rel, "")
        if old == new:
            continue
        changed = True
        sys.stdout.writelines(difflib.unified_diff(
            old.splitlines(keepends=True), new.splitlines(keepends=True),
            f"a/{rel}" if rel in before else "/dev/null", f"b/{rel}" if rel in after else "/dev/null"))
        if new and not new.endswith("\n"):
            print()
    if not changed:
        print("No changes.")
    print()
    return changed


def test_run(staging, applet):
    """Run a staged script applet once, with a throwaway data folder."""
    data = Path(tempfile.mkdtemp(prefix=f"applet-{applet['name']}-test-"))
    env = script_env({**applet, "dataDir": str(data)}, "refresh")
    try:
        result = subprocess.run([applet["entry"]], cwd=staging, env=env, timeout=applet["timeout"],
                                capture_output=True, text=True)
        try:
            print(json.dumps(json.loads(result.stdout), indent=2, ensure_ascii=False))
        except json.JSONDecodeError:
            print(result.stdout.rstrip() or "(no output)")
        if result.stderr.strip():
            print(result.stderr.rstrip(), file=sys.stderr)
        if result.returncode:
            print(f"exited with code {result.returncode}", file=sys.stderr)
    except subprocess.TimeoutExpired:
        print(f"timed out after {applet['timeout']}s", file=sys.stderr)
    finally:
        shutil.rmtree(data, ignore_errors=True)


def review(staging, assume_yes):
    """Ask whether to install (True) or discard (False) a staged applet."""
    if assume_yes:
        return True
    applet, _ = load(staging)
    script = applet["kind"] == "script"
    options = "[i]nstall, [t]est run, [d]iscard" if script else "[i]nstall, [d]iscard"
    while True:
        choice = input(f"{options}? ").strip().lower()
        if choice in ("i", "install", "y", "yes"):
            return True
        if choice in ("d", "discard", "n", "no", ""):
            return False
        if choice in ("t", "test") and script:
            print("Test run executes with your user permissions. Temporary APPLET_DATA does not restrict file access.")
            test_run(staging, applet)


def require_review_terminal(args):
    # Checked before asking the model, so no request is wasted.
    if not args.yes and not sys.stdin.isatty():
        die("review needs a terminal; pass --yes to accept without review")


def preferences(args):
    """Turn `qsa new` flags into instructions for the model."""
    wanted = []
    if args.qml:
        wanted.append("Make it a QML applet.")
    if args.surface:
        wanted.append(f'Use surface = "{args.surface}".')
    if args.bar:
        wanted.append("Give it a bar chip (bar = true, with an icon).")
    if args.bar_qml:
        wanted.append('Make it a bar-only applet with its own QML bar item (bar = "Bar.qml", no entry).')
    return " ".join(wanted)


# Commands ---------------------------------------------------------------------

def cmd_new(args):
    if not NAME_RE.match(args.name):
        die("names use lowercase letters, digits and dashes")
    if args.bar_qml and (args.qml or args.surface):
        die("--bar-qml creates a bar-only applet; it cannot be combined with --qml or --surface")
    if args.ai:
        return cmd_new_ai(args)
    folder = applets_home() / args.name
    if folder.exists():
        die(f"{folder} already exists")

    lines = [
        f'name = "{args.name}"',
        f'title = "{args.name.replace("-", " ").capitalize()}"',
    ]
    files = {}
    if args.bar_qml:
        lines += ['bar = "Bar.qml"']
        files["Bar.qml"] = BAR_QML_TEMPLATE
    else:
        entry = "main.qml" if args.qml else "main.sh"
        lines += [f'entry = "{entry}"', f'surface = "{args.surface or "popup"}"']
        if args.qml:
            lines += ["width = 320", "height = 160"]
            files[entry] = QML_TEMPLATE
        else:
            lines += ["interval = 60"]
            files[entry] = SCRIPT_TEMPLATE
        if args.bar:
            lines += ["bar = true", 'icon = "●"']
    files[MANIFEST] = "\n".join(lines) + "\n"

    folder.mkdir(parents=True)
    apply_files(folder, files, [])
    print(f"Created {folder}")
    if args.bar_qml:
        print("It appears in every AppletBar; edit Bar.qml and it reloads in place.")
    elif args.bar:
        print(f"It appears as a chip in every AppletBar. Open it with: qsa toggle {args.name}")
    else:
        print(f"Open it with: qsa toggle {args.name}")


def cmd_new_ai(args):
    require_review_terminal(args)
    ai = resolve_ai(args)
    target = applets_home() / args.name
    if target.exists():
        die(f"{target} already exists; use `qsa edit {args.name} --ai ...` to change it")
    prompt = (f"{guide()}\nCreate a new applet named {args.name!r} (folder and manifest name). "
              f"{preferences(args)}\n\nThe user wants:\n{args.ai.strip()}\n")
    with tempfile.TemporaryDirectory(prefix="applet-new-") as tmp:
        staging = Path(tmp) / args.name
        staging.mkdir()
        summary = generate(ai, prompt, staging, args.name)
        if summary:
            print(summary)
        show_files(staging)
        if not review(staging, args.yes):
            print("Discarded.")
            return
        applets_home().mkdir(parents=True, exist_ok=True)
        shutil.copytree(staging, target)
    print(f"Installed to {target}")


def cmd_edit(args):
    require_review_terminal(args)
    if not NAME_RE.fullmatch(args.name):
        die("'name' must be lowercase letters, digits and dashes (up to 40 characters)")
    target = applets_home() / args.name
    if not target.is_dir():
        die(f"no applet named '{args.name}' in {applets_home()}")
    try:
        reject_symlinks(target)
    except ValueError as error:
        die(str(error))
    ai = resolve_ai(args)
    before = text_files(target)
    prompt = (f"{guide()}\nChange the existing applet {args.name!r}. Return only files you create "
              "or change, with complete contents, and list removed files in \"delete\". "
              f"Keep the name.\n\nCurrent files:\n{render_files(before)}\n\n"
              f"The user wants:\n{args.ai.strip()}\n")
    with tempfile.TemporaryDirectory(prefix="applet-edit-") as tmp:
        staging = Path(tmp) / args.name
        shutil.copytree(target, staging, symlinks=True)
        summary = generate(ai, prompt, staging, args.name)
        if summary:
            print(summary)
        if not show_diff(before, staging):
            return
        if not review(staging, args.yes):
            print("Discarded; the applet is unchanged.")
            return
        replace_applet(staging, target)
    print(f"Updated {target}")


def cmd_install(args):
    source = args.source
    if source.startswith("gh:"):
        source = f"https://github.com/{source[3:]}.git"
    home = applets_home()
    home.mkdir(parents=True, exist_ok=True)
    # Hidden from the watcher and on the destination filesystem, so publishing
    # can never fall back to a partial copy into the live applet directory.
    with tempfile.TemporaryDirectory(prefix=".install-", dir=home) as tmp:
        staged = Path(tmp) / "applet"
        if Path(source).is_dir():
            try:
                reject_symlinks(Path(source))
            except ValueError as error:
                die(str(error))
            try:
                shutil.copytree(source, staged, symlinks=True, ignore=shutil.ignore_patterns(".git"))
            except OSError as error:
                die(f"could not stage applet: {error}")
        else:
            cloned = subprocess.run(["git", "clone", "--depth", "1", "--quiet", "--", source, str(staged)])
            if cloned.returncode:
                die(f"could not clone {source}")
        try:
            reject_symlinks(staged)
        except ValueError as error:
            die(str(error))
        if (staged / ".git").is_dir():
            shutil.rmtree(staged / ".git", ignore_errors=True)
        try:
            name = tomllib.loads((staged / MANIFEST).read_text()).get("name", "")
        except (OSError, tomllib.TOMLDecodeError, UnicodeDecodeError) as error:
            die(f"cannot read {MANIFEST}: {error}")
        if not isinstance(name, str) or not NAME_RE.fullmatch(name):
            die("the manifest needs a valid 'name'")
        target = home / name
        if target.exists() or target.is_symlink():
            die(f"{target} already exists; remove it first to reinstall")
        # load() requires the folder name to match the manifest name.
        named = Path(tmp) / name
        staged.rename(named)
        applet, error = load(named)
        if error:
            die(f"{name}: {error}")
        checks = []
        problems = static_problems(named, name, checks)
        if problems:
            die(f"{name}: validation failed:\n" + "\n".join(f"  {p}" for p in problems))
        surface = applet["surface"] if applet["entry"] else "bar only"
        print(f"{name}: {applet['title']} ({applet['kind']}, {surface})")
        if applet["description"]:
            print(f"  {applet['description']}")
        print("  Checks: " + "; ".join(checks))
        print("  Applets run with your user permissions. Files:")
        for item in sorted(p for p in named.rglob("*") if p.is_file()):
            print(f"    {item.relative_to(named)}")
        if not args.yes and input("Install? [y/N] ").strip().lower() != "y":
            die("cancelled")
        try:
            publish_applet(named, target)
        except OSError as error:
            die(f"could not install {name}: {error}")
    print(f"Installed to {target}")


def cmd_remove(args):
    # Invalid manifests may still be removed, but the argument must be one
    # visible folder name, never a path or a symlink alias.
    name = args.name
    if not name or name.startswith(".") or Path(name).name != name or any(ord(c) < 32 for c in name):
        die("remove expects one non-hidden applet folder name, not a path")
    home = applets_home().resolve()
    folder = home / name
    if folder.is_symlink():
        die(f"refusing to remove a symlink applet folder: {folder}")
    if not folder.is_dir():
        die(f"no applet named '{name}' in {home}")
    if not args.yes and not sys.stdin.isatty():
        die("confirmation needs a terminal; pass --yes to remove without asking")
    data = data_dir(name)
    targets = [folder]
    if not args.keep_data:
        if data.parent.is_symlink() or data.is_symlink():
            die(f"refusing to remove data through a symlink: {data}")
        if data.exists() and not data.is_dir():
            die(f"applet data is not a directory: {data}")
        if data.is_dir():
            data = data.parent.resolve() / name
            targets.append(data)
    # Overlapping paths can destroy kept data or unrelated applets when the
    # config and data roots are accidentally pointed into one another.
    resolved_data = data.resolve()
    if resolved_data == folder or folder in resolved_data.parents or resolved_data in folder.parents:
        die("applet and data folders overlap; correct APPLETS_HOME/XDG_DATA_HOME before removing")
    if not shutil.rmtree.avoids_symlink_attacks:
        die("safe removal requires symlink-resistant directory deletion")

    # Pin each parent directory and record the child's identity before asking.
    # Recheck every target before deleting any, so changes during confirmation
    # cannot redirect removal to a sibling or an external directory.
    with contextlib.ExitStack() as stack:
        pinned = []
        try:
            for target in targets:
                fd = os.open(target.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
                stack.callback(os.close, fd)
                info = os.stat(name, dir_fd=fd, follow_symlinks=False)
                if not stat.S_ISDIR(info.st_mode):
                    die(f"refusing to remove a non-directory: {target}")
                parent_info = os.fstat(fd)
                pinned.append((target, fd, (info.st_dev, info.st_ino),
                               (parent_info.st_dev, parent_info.st_ino)))
        except OSError as error:
            die(f"cannot validate removal targets: {error}")
        print("Removes:")
        for target in targets:
            print(f"  {target}")
        if args.keep_data:
            print(f"Keeps its data: {data}")
        if not args.yes and input("Remove? [y/N] ").strip().lower() != "y":
            die("cancelled")
        try:
            for target, fd, identity, parent_identity in pinned:
                parent_info = os.stat(target.parent, follow_symlinks=False)
                info = os.stat(name, dir_fd=fd, follow_symlinks=False)
                if (not stat.S_ISDIR(parent_info.st_mode)
                        or (parent_info.st_dev, parent_info.st_ino) != parent_identity
                        or not stat.S_ISDIR(info.st_mode) or (info.st_dev, info.st_ino) != identity):
                    die(f"removal target changed; nothing removed: {target}")
        except OSError as error:
            die(f"removal target changed; nothing removed: {error}")
        for target, fd, identity, parent_identity in pinned:
            shutil.rmtree(name, dir_fd=fd)
    print(f"Removed {name}")


def cmd_list(args):
    applets, invalid = scan()
    if args.json:
        print(json.dumps({"applets": applets, "invalid": invalid}, indent=2))
        return
    if not applets and not invalid:
        print(f"No applets in {applets_home()}. Create one with: qsa new <name>")
    for applet in applets:
        key = f"  [{applet['key']}]" if applet["key"] else ""
        surface = applet["surface"] if applet["entry"] else "-"
        bar = "" if applet["bar"] == "none" else "bar"
        print(f"{applet['name']:<16} {applet['kind']:<6} {surface:<8} {bar:<4} {applet['title']}{key}")
    for item in invalid:
        print(f"{item['name']:<16} INVALID  {item['error']}")


def cmd_check(args):
    applets, invalid = scan()

    def wanted(name):
        return not args.name or name == args.name

    failed = [i for i in invalid if wanted(i["name"])]
    for item in failed:
        print(f"✗ {item['name']}: {item['error']}")
    for applet in applets:
        if wanted(applet["name"]):
            print(f"✓ {applet['name']}")
    if args.name and not failed and not any(a["name"] == args.name for a in applets):
        die(f"no applet named '{args.name}'")
    sys.exit(1 if failed else 0)


def cmd_run(args):
    """Run a script applet once (or stream it) and pass its output through.

    The output is Waybar-compatible: use `qsa run <name>` as a custom module
    with "return-type": "json".
    """
    applet = find(args.name)
    if applet["kind"] != "script":
        die(f"{args.name} is a QML applet; only script applets can be run")
    Path(applet["dataDir"]).mkdir(parents=True, exist_ok=True)
    argv, event = [applet["entry"]], "refresh"
    if args.action:
        argv, event = [applet["entry"], "action", args.action], "action"
    elif args.input is not None:
        argv, event = [applet["entry"], "input", args.input], "input"
    timeout = None if applet["stream"] and event == "refresh" else applet["timeout"]
    try:
        result = subprocess.run(argv, cwd=applet["dir"], env=script_env(applet, event), timeout=timeout)
    except subprocess.TimeoutExpired:
        die(f"{args.name} timed out after {applet['timeout']}s")
    sys.exit(result.returncode)


def cmd_setup(args):
    """Link the module into a Quickshell config, enabling `import qs.Applets`."""
    config = Path(os.path.expanduser(args.config)).resolve()
    if not (config / "shell.qml").is_file():
        die(f"{config} has no shell.qml; pass your Quickshell config folder")
    link, module = config / "Applets", RUNTIME / "Applets"
    if link.is_symlink() and link.resolve() == module.resolve():
        print(f"{link} already points to {module}")
    elif link.exists() or link.is_symlink():
        die(f"{link} already exists and is not a link to {module}")
    else:
        link.symlink_to(module)
        print(f"Linked {link} -> {module}")
    print(f"""
Add to {config / 'shell.qml'}:

    import qs.Applets

    // once, inside ShellRoot
    AppletsHost {{
        id: applets
        theme: Theme        // optional: your theme object, see SPEC.md
    }}

    // inside each bar, where bar applets should appear
    AppletBar {{ host: applets }}

Stop the standalone runtime if it is running: qs kill -p {RUNTIME}""")


def cmd_daemon(args):
    require_qs()
    if args.replace:
        subprocess.run(["qs", "kill", "-p", str(RUNTIME)], capture_output=True)
        # The old instance needs a moment to exit, or -n would refuse to start.
        for _ in range(30):
            if not runtime_running():
                break
            time.sleep(0.1)
    if hosts_applets([]):
        die("your Quickshell config already embeds applets; the standalone runtime would show them twice")
    env = dict(os.environ, APPLETS_HOME=str(applets_home()))
    flags = ["-n"] + (["-d"] if args.detach else [])  # -n: refuse a second instance
    os.execvpe("qs", ["qs", *flags, "-p", str(RUNTIME)], env)


def cmd_window(args):
    # `show` collides with a qs ipc subcommand, so the IPC names are open/close.
    ipc({"show": "open", "hide": "close"}.get(args.command, args.command), args.name)


def cmd_send(args):
    if args.action is not None:
        ipc("action", args.name, args.action)
    else:
        ipc("submit", args.name, args.input)


def bind_key(key, flavour):
    """Convert a manifest key such as "SUPER + CTRL + T" to compositor syntax."""
    parts = key.replace("+", " ").split()
    if flavour == "hyprland":
        return " + ".join(p.upper() for p in parts)
    names = {"SUPER": "Mod4", "CTRL": "Ctrl", "CONTROL": "Ctrl", "SHIFT": "Shift", "ALT": "Mod1"}
    return "+".join(names.get(p.upper(), p.lower()) for p in parts)


def cmd_binds(args):
    cli = "qsa" if shutil.which("qsa") else str(Path(__file__).resolve())
    for applet in scan()[0]:
        if not applet["key"]:
            continue
        command = f"{cli} toggle {applet['name']}"
        if args.sway:
            print(f"bindsym {bind_key(applet['key'], 'sway')} exec {command}")
        else:
            print(f'hl.bind("{bind_key(applet["key"], "hyprland")}", hl.dsp.exec_cmd("{command}"))')


def cmd_watch(args):
    """Print the registry as one JSON line whenever any applet changes.

    Started by AppletsHost. Polling keeps it free of extra dependencies, and
    data folders are created here so the shell can write store.json.
    """
    applets_home().mkdir(parents=True, exist_ok=True)
    previous = None
    while True:
        try:
            stamp = [(p.name, revision(p)) for p in applet_folders()]
            if stamp != previous:
                previous = stamp
                applets, invalid = scan()
                revisions = dict(stamp)
                for applet in applets:
                    applet["revision"] = revisions.get(applet["name"], 0)
                    Path(applet["dataDir"]).mkdir(parents=True, exist_ok=True)
                print(json.dumps({"applets": applets, "invalid": invalid}), flush=True)
        except OSError as error:
            print(f"qsa watch: {error}", file=sys.stderr, flush=True)
        time.sleep(args.poll)


def main():
    parser = argparse.ArgumentParser(prog="qsa", description="Applets for Quickshell: tiny desktop apps.")
    sub = parser.add_subparsers(dest="cmd", required=True, metavar="COMMAND")

    def ai_options(p, yes_help):
        p.add_argument("--with", dest="provider", choices=PROVIDERS,
                       help="AI CLI to use (default: claude if installed, else codex)")
        p.add_argument("--model", help="model to use (default: the one set in the CLI's config)")
        p.add_argument("-y", "--yes", action="store_true", help=yes_help)

    p = sub.add_parser("new", help="create an applet from a template or a description")
    p.add_argument("name")
    p.add_argument("--qml", action="store_true", help="QML applet instead of a script")
    p.add_argument("--surface", choices=SURFACES, help="window type (default popup)")
    group = p.add_mutually_exclusive_group()
    group.add_argument("--bar", action="store_true", help="also show a chip in the bar")
    group.add_argument("--bar-qml", action="store_true", help="bar-only applet with its own QML bar item")
    p.add_argument("--ai", metavar="DESCRIPTION", help="have Claude or Codex write it from a description")
    ai_options(p, "with --ai: install without review")
    p.set_defaults(func=cmd_new)

    p = sub.add_parser("edit", help="change an applet with Claude or Codex")
    p.add_argument("name")
    p.add_argument("--ai", metavar="REQUEST", required=True, help="what to change")
    ai_options(p, "apply without review")
    p.set_defaults(func=cmd_edit)

    p = sub.add_parser("install", help="install from a folder, git URL or gh:user/repo")
    p.add_argument("source")
    p.add_argument("-y", "--yes", action="store_true", help="do not ask for confirmation")
    p.set_defaults(func=cmd_install)

    p = sub.add_parser("remove", help="delete an applet and its data")
    p.add_argument("name")
    p.add_argument("--keep-data", action="store_true", help="keep its data folder (store, script state)")
    p.add_argument("-y", "--yes", action="store_true", help="do not ask for confirmation")
    p.set_defaults(func=cmd_remove)

    p = sub.add_parser("list", help="list installed applets")
    p.add_argument("--json", action="store_true", help="print the normalized manifests")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("check", help="validate manifests")
    p.add_argument("name", nargs="?")
    p.set_defaults(func=cmd_check)

    p = sub.add_parser("run", help="run a script applet once (Waybar-compatible output)")
    p.add_argument("name")
    group = p.add_mutually_exclusive_group()
    group.add_argument("--action", metavar="ID")
    group.add_argument("--input", metavar="TEXT")
    p.set_defaults(func=cmd_run)

    p = sub.add_parser("setup", help="embed applets in an existing Quickshell config")
    p.add_argument("config", nargs="?", default="~/.config/quickshell",
                   help="config folder (default ~/.config/quickshell)")
    p.set_defaults(func=cmd_setup)

    p = sub.add_parser("daemon", help="start the standalone runtime")
    p.add_argument("-d", "--detach", action="store_true", help="run in the background")
    p.add_argument("--replace", action="store_true", help="stop a running runtime first")
    p.set_defaults(func=cmd_daemon)

    for command, text in (("toggle", "show or hide"), ("show", "show"), ("hide", "hide")):
        p = sub.add_parser(command, help=f"{text} an applet's window")
        p.add_argument("name")
        p.set_defaults(func=cmd_window, command=command)

    p = sub.add_parser("send", help="trigger an action or submit input in a running applet")
    p.add_argument("name")
    group = p.add_mutually_exclusive_group(required=True)
    group.add_argument("--action", metavar="ID")
    group.add_argument("--input", metavar="TEXT")
    p.set_defaults(func=cmd_send)

    p = sub.add_parser("binds", help="print compositor keybindings from manifests")
    p.add_argument("--sway", action="store_true", help="sway syntax instead of Hyprland Lua")
    p.set_defaults(func=cmd_binds)

    p = sub.add_parser("path", help="print the applets folder")
    p.set_defaults(func=lambda _: print(applets_home()))

    # Internal: started by AppletsHost. Without `help` it is not listed.
    p = sub.add_parser("watch")
    p.add_argument("--poll", type=float, default=1.0)
    p.set_defaults(func=cmd_watch)

    args = parser.parse_args()
    try:
        args.func(args)
    except KeyboardInterrupt:
        stop_child()
        print(file=sys.stderr)
        sys.exit(130)


if __name__ == "__main__":
    main()
