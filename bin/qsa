#!/usr/bin/env python3
"""qsa: the command-line tool of Applets for Quickshell.

Creates, checks, runs and controls tiny desktop applets.

Applets live in $APPLETS_HOME (default $XDG_CONFIG_HOME/applets), one folder
per applet with an applet.toml manifest. The Quickshell module in
runtime/Applets hosts them, embedded in a shell (`qsa setup`) or in the
standalone runtime (`qsa daemon`). This CLI also feeds that module the
applet registry (`qsa watch`) and talks to it over Quickshell IPC.

See SPEC.md for the applet format and README.md for usage.
"""

import argparse
import contextlib
import ctypes
import difflib
import hashlib
import json
import os
import re
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time
import tomllib
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
RUNTIME = REPO / "runtime"
MANIFEST = "applet.toml"

NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,39}$")
SURFACES = ("popup", "floating", "desktop")
POSITIONS = ("top-left", "top", "top-right", "left", "center", "right",
             "bottom-left", "bottom", "bottom-right")
LAYERS = ("below", "above")


def xdg(var, fallback):
    return Path(os.environ.get(var) or Path.home() / fallback)


def applets_home():
    return Path(os.environ.get("APPLETS_HOME") or xdg("XDG_CONFIG_HOME", ".config") / "applets")


def data_dir(name):
    return xdg("XDG_DATA_HOME", ".local/share") / "applets" / name


def die(message):
    print(f"qsa: {message}", file=sys.stderr)
    sys.exit(1)


# Manifests --------------------------------------------------------------------

def load(folder):
    """Return (applet, None) or (None, error) for one applet folder.

    The applet dict is the normalized manifest the QML module consumes: paths
    are absolute, `bar` is "none", "chip" or "qml", and defaults are filled in.
    """
    folder = Path(folder)
    try:
        raw = tomllib.loads((folder / MANIFEST).read_text())
    except FileNotFoundError:
        return None, f"missing {MANIFEST}"
    except (tomllib.TOMLDecodeError, UnicodeDecodeError) as error:
        return None, f"{MANIFEST}: {error}"

    def field(key, kind, default):
        value = raw.get(key, default)
        # bool is a subclass of int, so `true` must not pass as an int.
        if not isinstance(value, kind) or isinstance(value, bool) and kind is not bool:
            raise ValueError(f"'{key}' must be {kind.__name__}")
        return value

    def inside(key, value):
        path = (folder / value).resolve()
        if folder.resolve() not in path.parents:
            raise ValueError(f"'{key}' must stay inside the applet folder")
        if not path.is_file():
            raise ValueError(f"{key} '{value}' does not exist")
        return path

    try:
        name = field("name", str, folder.name)
        if not NAME_RE.match(name):
            raise ValueError("'name' must be lowercase letters, digits and dashes")
        if name != folder.name:
            raise ValueError(f"'name' ({name}) must match its folder ({folder.name})")

        bar_raw = raw.get("bar", False)
        if isinstance(bar_raw, bool):
            bar, bar_entry = ("chip" if bar_raw else "none"), ""
        elif isinstance(bar_raw, str) and bar_raw.endswith(".qml"):
            bar, bar_entry = "qml", str(inside("bar", bar_raw))
        else:
            raise ValueError("'bar' must be true, false or a .qml file")

        entry = field("entry", str, "")
        if not entry and bar != "qml":
            raise ValueError("'entry' is required unless 'bar' names a .qml file")
        entry_path = inside("entry", entry) if entry else None
        # A bar-only applet has no entry; it counts as QML.
        kind = "qml" if not entry_path or entry_path.suffix == ".qml" else "script"
        if kind == "script" and not os.access(entry_path, os.X_OK):
            raise ValueError(f"script entry '{entry}' is not executable (chmod +x)")

        surface = field("surface", str, "popup")
        if surface not in SURFACES:
            raise ValueError(f"'surface' must be one of {', '.join(SURFACES)}")
        position = field("position", str, "top-right")
        if position not in POSITIONS:
            raise ValueError(f"'position' must be one of {', '.join(POSITIONS)}")
        layer = field("layer", str, "below")
        if layer not in LAYERS:
            raise ValueError(f"'layer' must be one of {', '.join(LAYERS)}")
        interval = field("interval", int, 0)
        timeout = field("timeout", int, 20)
        if interval < 0 or timeout <= 0:
            raise ValueError("'interval' must be >= 0 and 'timeout' > 0")

        applet = {
            "name": name,
            "title": field("title", str, name),
            "description": field("description", str, ""),
            "dir": str(folder.resolve()),
            "entry": str(entry_path) if entry_path else "",
            "kind": kind,
            "icon": field("icon", str, ""),
            "bar": bar,
            "barEntry": bar_entry,
            "surface": surface,
            "position": position,
            "layer": layer,
            "screen": field("screen", str, ""),
            "width": field("width", int, 420),
            "height": field("height", int, 0),
            "interval": interval,
            "timeout": timeout,
            "stream": field("stream", bool, False),
            "input": field("input", bool, False),
            "placeholder": field("placeholder", str, ""),
            "key": field("key", str, ""),
            "config": field("config", dict, {}),
            "dataDir": str(data_dir(name)),
        }
        if kind == "qml" and (applet["stream"] or applet["input"] or applet["interval"]):
            raise ValueError("'stream', 'input' and 'interval' apply to script applets only")
    except ValueError as error:
        return None, str(error)
    return applet, None


def applet_folders():
    home = applets_home()
    if not home.is_dir():
        return []
    return sorted(p for p in home.iterdir() if p.is_dir() and not p.name.startswith("."))


def scan():
    """All applets as (valid applets, [{name, error}] for invalid ones)."""
    applets, invalid = [], []
    for folder in applet_folders():
        applet, error = load(folder)
        if error:
            invalid.append({"name": folder.name, "error": error})
        else:
            applets.append(applet)
    return applets, invalid


def find(name):
    folder = applets_home() / name
    if not folder.is_dir():
        die(f"no applet named '{name}' in {applets_home()}")
    applet, error = load(folder)
    if error:
        die(f"{name}: {error}")
    return applet


def revision(folder):
    """Fingerprint paths and metadata, including deletions and preserved mtimes.

    A 48-bit integer remains exact in QML's double-precision revision property.
    """
    digest = hashlib.blake2b(digest_size=6)
    for root, dirs, files in os.walk(folder):
        dirs[:] = [d for d in dirs if not d.startswith(".") and d != "__pycache__"]
        dirs.sort()
        for item in sorted(files):
            try:
                path = Path(root) / item
                stat = path.lstat()
                digest.update(json.dumps([str(path.relative_to(folder)), stat.st_mode,
                                          stat.st_size, stat.st_mtime_ns,
                                          stat.st_ctime_ns, stat.st_ino]).encode())
            except OSError:
                pass
    return int.from_bytes(digest.digest(), "big")


def script_env(applet, event):
    """Environment for a script run (SPEC.md "Invocation")."""
    env = dict(os.environ)
    env.update({
        "APPLET_NAME": applet["name"],
        "APPLET_DIR": applet["dir"],
        "APPLET_DATA": applet["dataDir"],
        "APPLET_CONFIG": json.dumps(applet["config"]),
        "APPLET_EVENT": event,
    })
    return env


# Quickshell -------------------------------------------------------------------

def require_qs():
    if not shutil.which("qs"):
        die("Quickshell (qs) is not installed")


def runtime_running():
    listing = subprocess.run(["qs", "list", "-p", str(RUNTIME)], capture_output=True, text=True)
    return listing.returncode == 0 and "No running instances" not in listing.stdout + listing.stderr


def shell_target():
    """qs arguments selecting the instance that hosts applets.

    APPLETS_SHELL (a config path) wins; then a running standalone runtime;
    otherwise the default Quickshell config, where applets are embedded.
    """
    if os.environ.get("APPLETS_SHELL"):
        return ["-p", os.path.expanduser(os.environ["APPLETS_SHELL"])]
    if runtime_running():
        return ["-p", str(RUNTIME)]
    return []


def hosts_applets(target):
    """Whether the selected instance runs an AppletsHost (its IPC target)."""
    shown = subprocess.run(["qs", "ipc", *target, "show"], capture_output=True, text=True)
    return shown.returncode == 0 and re.search(r"^target applets$", shown.stdout, re.M) is not None


def ipc(*call):
    """Call an `applets` IPC function, which answers "ok" or an error."""
    require_qs()
    target = shell_target()
    if not hosts_applets(target):
        die("no running Quickshell hosts applets; start `qsa daemon -d` or embed them (`qsa setup`)")
    # A just-created applet appears within the shell's next scan (about a
    # second), so retry briefly while its folder exists.
    deadline = time.monotonic() + 3
    while True:
        result = subprocess.run(["qs", "ipc", *target, "call", "applets", *call],
                                capture_output=True, text=True)
        reply = (result.stdout + result.stderr).strip()
        pending = reply.startswith("unknown") and (applets_home() / call[1]).is_dir()
        if not pending or time.monotonic() > deadline:
            break
        time.sleep(0.2)
    if result.returncode or reply != "ok":
        die(reply or f"qs ipc failed with code {result.returncode}")


